# Public site origin (used by sitemap, robots, Open Graph)
NEXT_PUBLIC_SITE_URL=https://qikolabs.com

# Signal marketing site — used for the delineation link
NEXT_PUBLIC_SIGNAL_SITE_URL=https://qiko.ai

# Calendly scheduling page for Book a call
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-org/qiko-labs-demo

# Optional: proxy enquiry form to qiko-core marketing API
# POST {base}/api/v1/marketing/labs-contact
NEXT_PUBLIC_APP_BASE_URL=

# Set true on staging / preview hosts
SITE_NOINDEX=false
